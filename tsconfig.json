{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "src",
    "tui.tsx",
    "test",
    "scripts"
  ]
}

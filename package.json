{
  "name": "hivemind-substrate",
  "version": "0.1.0",
  "description": "OpenCode V2 Context & Working-Memory Substrate plugin: unifies session/delegation archival, step-watermark working-set pruning, compaction continuity, and AST/PageRank/co-change codebase viewports.",
  "license": "MIT",
  "author": "shynlee04",
  "type": "module",
  "main": "index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "hivemind-substrate": "bin/install.mjs",
    "hivemind-session-archive": "bin/install.mjs"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "local-build": "node scripts/local-build.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "substrate": "bun src/cli.ts",
    "prepublishOnly": "bun test && bun run typecheck && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-substrate",
    "session-archive",
    "context-prune",
    "compaction-continuity",
    "repomap",
    "tui"
  ],
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.28 <3",
    "@opencode/theme": ">=2.0.28 <3",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/theme": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "latest",
    "solid-js": "1.9.15",
    "typescript": "latest"
  },
  "overrides": {
    "@opencode/theme": {
      "@opentui/core": "0.5.17"
    }
  }
}
